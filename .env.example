# pgassistant 环境变量参考（变量直接设在进程环境里；项目不读取 .env 文件，.env 也不入库）
# Windows 可在「系统属性 → 环境变量」里配置，或在启动前用 set / $env: 临时设置。

# 监听地址。默认只绑本机；改成 0.0.0.0 会让同网段所有人都能访问，
# 而鉴权（§13.7）只防浏览器跨站，不防局域网扫描 —— 改之前想清楚。
PG_HOST=127.0.0.1

# 服务端口
PG_PORT=8000

# 内容目录（相对路径按项目根解析）
PG_CONTENT_DIR=./content

# 数据库文件
PG_DB=./data/app.db

# 日志级别: DEBUG / INFO / WARNING
PG_LOG_LEVEL=INFO

# 允许的跨源来源（逗号分隔）。只在开发态直连 Vite dev server 时需要；
# 走 Vite proxy 或生产同源部署都可以留空。
PG_DEV_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 内容源（tools/prepare_content.py 使用，只在首次准备 / 重建内容库时读取）。
# 国内网络访问 GitHub 慢或失败时，建议配置镜像或给 git 设置代理，否则首次运行
# 可能只拿到部分资料（例如没有算法内容）。
#
# PG_GIT_MIRROR：GitHub 前缀式镜像，把官方地址里的 https://github.com 换成这个前缀。
# 镜像失败会自动回退官方地址。下面的域名只是示例，换成你实际可用的镜像。
# 例：PG_GIT_MIRROR=https://ghfast.top/https://github.com
PG_GIT_MIRROR=

# 直接指定仓库地址（指定后只尝试该地址，不再回退）。适合自建镜像或内网 Git 服务。
PG_HELLO_ALGO_URL=https://github.com/krahets/hello-algo
PG_JWASHAM_URL=https://github.com/jwasham/coding-interview-university

# 模型配置在设置页填写，不要写进这里：
# 一旦写进 .env 就很容易被 commit 上去
# PG_LLM_API_KEY=

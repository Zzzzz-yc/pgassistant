# 抓取/转换生成的内容不入库；手写的元数据（分类名、计划模板、分词词典）必须入库
content/*
!content/_meta/
!content/_meta/**

# 运行时数据
data/
!data/.gitkeep
data/backups/
*.db
*.db-journal
*.db-wal
*.db-shm

# 本地依赖（jieba 等，用 requirements.txt 恢复）
.deps/
.venv/

# 密钥与本地配置
.env
.env.*
!.env.example
secrets.json
config.json

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# 测试与分词缓存（可随时删除，重跑即重建）
jieba.cache
pytest-of-*/

# 测试临时目录（pytest --basetemp / vite 临时产物；即便落在 data/ 下也显式忽略）
data/.vite-tmp/
data/.pytest-tmp*/

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo

# 日志与临时
*.log
logs/
tmp/
.cache/
.m3-*
.shots/

# 编辑器 / 系统
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Obsidian / 本地编辑器配置：本人笔记库配置，含社区插件二进制，不入库
.obsidian/
.claudian/

# git worktree 并行开发目录（每个分支一份工作副本，属本地产物）
.worktrees/

# 大文件（注意不要写 *.png / *.webp，否则 content/assets 会漏提交）
*.mp4
*.mov
*.zip

# 交接包备份（项目根就是本仓库，这里只作为后备资料库，绝不入库）
handoff/

# Pyodide 运行时副本（M6 由 frontend/scripts/copy-pyodide.mjs 在 predev/prebuild 生成，
# 13 MB 二进制不入库；离线前提是至少完成过一次 npm install）
frontend/public/assets/pyodide/
frontend/public/pyodide/

# 抓取/转换生成的内容不入库；手写的元数据（分类名、计划模板、分词词典）必须入库
content/*
!content/_meta/
!content/_meta/**

# 运行时数据
data/
!data/.gitkeep
data/backups/
*.db
*.db-journal
*.db-wal
*.db-shm

# 本地依赖（jieba 等，用 requirements.txt 恢复）
.deps/
.venv/

# 密钥与本地配置
.env
.env.*
!.env.example
secrets.json
config.json

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# 测试与分词缓存（可随时删除，重跑即重建）
jieba.cache
pytest-of-*/

# 测试临时目录（pytest --basetemp / vite 临时产物；即便落在 data/ 下也显式忽略）
data/.vite-tmp/
data/.pytest-tmp*/

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo

# PyInstaller 单文件构建产物（tools/build_exe.py 生成，本机产物不入库）
pgassistant.exe
build/
*.spec

# 日志与临时
*.log
logs/
tmp/
.cache/

# 本地临时产物（截图等）
.m3-*
.shots/

# 编辑器 / 系统
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# 本地笔记库与编辑器插件目录（含二进制，不入库）
.obsidian/
.claudian/

# 并行工作副本目录（本地产物）
.worktrees/

# 大文件（图片除外：content/assets 的配图需入库）
*.mp4
*.mov
*.zip

# 工作过程资料，不入库
handoff/

# Pyodide 运行时副本（构建时生成，13 MB 二进制不入库；离线需先完成一次构建）
frontend/public/assets/pyodide/
frontend/public/pyodide/

# 本地导出物与编辑器/合并临时文件（防止顺手把成品文档或冲突残渣提交）
*.docx
*.bak
*.orig
*.rej
*.tmp
*.swp
coverage/
.coverage
htmlcov/
.mypy_cache/
.eslintcache

# 内容准备过程中的中间产物
*.partial
data/.sources/
data/.repro/

# pip 中断时在仓库根留下的临时目录/文件（两种形态都可能出现）
/pip-*
